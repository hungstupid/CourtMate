        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;C4Context\n  title System Context Diagram cho CourtMate (PA2)\n\n  Person(visitor, \&quot;Visitor\&quot;, \&quot;Khách chưa đăng nhập. Tìm kiếm sân, xem lịch trống và danh sách phòng Open Play công khai.\&quot;)\n  Person(player, \&quot;Player\&quot;, \&quot;Người chơi đã xác thực. Đặt sân, hủy lịch, tạo và quản lý phòng Open Play (bao gồm vai trò Organizer).\&quot;)\n  Person(owner, \&quot;Court Owner\&quot;, \&quot;Chủ sân đã xác thực. Quản lý thông tin sân, thiết lập lịch hoạt động, bảo trì và ưu đãi (Deals).\&quot;)\n\n  System(courtmate, \&quot;CourtMate\&quot;, \&quot;Hệ thống quản lý đặt sân thể thao và kết nối người chơi qua Open Play Rooms.\&quot;)\n\n  System_Ext(firebase, \&quot;Firebase Authentication\&quot;, \&quot;Dịch vụ định danh bên ngoài. Quản lý đăng nhập và cấp phát ID tokens.\&quot;)\n\n  Rel(visitor, courtmate, \&quot;Tìm kiếm, xem thông tin sân &amp; phòng\&quot;)\n  Rel(player, courtmate, \&quot;Đặt sân, quản lý booking &amp; tham gia phòng\&quot;)\n  Rel(owner, courtmate, \&quot;Quản lý sân, lịch trống &amp; bảo trì\&quot;)\n  \n  Rel(courtmate, firebase, \&quot;Xác thực danh tính (Verify ID tokens)\&quot;)&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="NSD62qRu7I0V5rFm2Oiy-1">
