        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%%{init: {&#39;theme&#39;: &#39;base&#39;, &#39;themeVariables&#39;: { &#39;fontSize&#39;: &#39;16px&#39;, &#39;fontFamily&#39;: &#39;Arial&#39; }, &#39;flowchart&#39;: { &#39;nodeSpacing&#39;: 80, &#39;rankSpacing&#39;: 100, &#39;curve&#39;: &#39;basis&#39; }}}%%\nflowchart TB\n  subgraph client [\&quot;&lt;b&gt;Client Device (Desktop / Mobile OS)&lt;/b&gt;\&quot;]\n    spa[\&quot;&lt;b&gt;Web Browser — CourtMate SPA&lt;/b&gt;&lt;br/&gt;[React, TypeScript, Vite]&lt;br/&gt;Responsive UI across 375px, 768px, and 1280px viewports\&quot;]\n  end\n\n  subgraph vercel [\&quot;&lt;b&gt;Vercel Cloud Platform (Frontend Edge Network)&lt;/b&gt;\&quot;]\n    cdn[\&quot;&lt;b&gt;Static Asset Host&lt;/b&gt;&lt;br/&gt;[Vercel Global CDN]&lt;br/&gt;Serves compiled HTML, CSS, and JS bundle\&quot;]\n  end\n\n  subgraph gcp [\&quot;&lt;b&gt;Google Cloud Platform (External Identity Node)&lt;/b&gt;\&quot;]\n    firebase[\&quot;&lt;b&gt;Firebase Authentication&lt;/b&gt;&lt;br/&gt;[External Identity Service]&lt;br/&gt;Manages email/password sign-in, issues JWTs &amp; JWKS keys\&quot;]\n  end\n\n  subgraph render [\&quot;&lt;b&gt;Render Cloud Platform (Application Compute Node)&lt;/b&gt;\&quot;]\n    api[\&quot;&lt;b&gt;FastAPI Backend Service&lt;/b&gt;&lt;br/&gt;[Python 3, FastAPI, Uvicorn ASGI]&lt;br/&gt;Enforces server clock (UTC+7), local JWT check,&lt;br/&gt;RBAC/ownership, and transactional services\&quot;]\n  end\n\n  subgraph neon [\&quot;&lt;b&gt;Neon Serverless Cloud (Database Cloud Node)&lt;/b&gt;\&quot;]\n    db[(\&quot;&lt;b&gt;CourtMate Relational Database&lt;/b&gt;&lt;br/&gt;[PostgreSQL 17 Instance]&lt;br/&gt;Persists 11 tables, indexes, and row-level locks\&quot;)]\n  end\n\n  %% Connections\n  spa --&gt;|\&quot;1. Loads static SPA bundle [HTTPS / TLS 1.3]\&quot;| cdn\n  spa --&gt;|\&quot;2. Email/password sign-in -&gt; ID token (JWT) [HTTPS]\&quot;| firebase\n  spa --&gt;|\&quot;3. REST API requests + Bearer JWT [HTTPS / JSON Port 443]\&quot;| api\n  api --&gt;|\&quot;4. Fetches public JWKS keys to verify JWT [HTTPS Port 443]\&quot;| firebase\n  api --&gt;|\&quot;5. Executes ACID transactions &amp; row locks [TLS / TCP Port 5432]\&quot;| db\n\n  %% Styling matching your image\n  classDef blueActor fill:#0044FF,stroke:#002DB3,stroke-width:2px,color:#FFFFFF,rx:12,ry:12;\n  classDef compBox fill:#1168BD,stroke:#0B4884,stroke-width:2px,color:#FFFFFF,rx:10,ry:10;\n  classDef darkBox fill:#08427B,stroke:#052E56,stroke-width:2px,color:#FFFFFF,rx:10,ry:10;\n  classDef extBox fill:#8C8C8C,stroke:#666666,stroke-width:2px,color:#FFFFFF,rx:10,ry:10;\n  classDef nodeBoundary fill:#F4F8FB,stroke:#0B4884,stroke-width:2px,stroke-dasharray: 5 5,color:#08427B;\n\n  class spa blueActor;\n  class cdn,api compBox;\n  class db darkBox;\n  class firebase extBox;\n  class client,vercel,gcp,render,neon nodeBoundary;\n\n  linkStyle default stroke:#555555,stroke-width:2px,color:#0000FF;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="V1EOGs5bZ6Y0wQE25J3v-18">
