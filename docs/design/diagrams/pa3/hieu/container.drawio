        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;C4Container\n  title Container Diagram for CourtMate (C4 Level 2)\n\n  Person(visitor, \&quot;Visitor\&quot;, \&quot;Unauthenticated user. Finding, seeing court detail, published slots and Open Play Room.\&quot;)\n  Person(player, \&quot;Player\&quot;, \&quot;Authenticated Player role. Booking, create and manage Open Play Room as Organizer.\&quot;)\n  Person(owner, \&quot;Court Owner\&quot;, \&quot;Authenticated Court Owner role. Create and manage court detail, schedule, maintenance and deals.\&quot;)\n\n  System_Boundary(courtmate, \&quot;CourtMate\&quot;) {\n    Container(spa, \&quot;Single-Page Application\&quot;, \&quot;React, TypeScript, Vite\&quot;, \&quot;Renders responsive UI (375/768/1280px), search filters, slot previews, and multi-slot selection drafts.\&quot;)\n    Container(api, \&quot;Backend API Application\&quot;, \&quot;Python, FastAPI, SQLAlchemy 2.0\&quot;, \&quot;Verifies JWTs, enforces RBAC and ownership, executes Courts, Bookings, Rooms, and Offers domain logic.\&quot;)\n    ContainerDb(db, \&quot;Relational Database\&quot;, \&quot;PostgreSQL 17 (Neon)\&quot;, \&quot;Stores 11 application tables, constraints, booking snapshots, and row-level locks.\&quot;)\n  }\n\n  System_Ext(firebase, \&quot;Firebase Authentication\&quot;, \&quot;External Service. Manage authentication and provide ID tokens (JWT).\&quot;)\n\n  Rel(visitor, spa, \&quot;See court, slots and public rooms\&quot;, \&quot;HTTPS\&quot;)\n  Rel(player, spa, \&quot;Booking, manage and join rooms\&quot;, \&quot;HTTPS\&quot;)\n  Rel(owner, spa, \&quot;Managing court, schedule, maintenance and deals\&quot;, \&quot;HTTPS\&quot;)\n\n  Rel(spa, firebase, \&quot;Sign-up and sign-in\&quot;, \&quot;HTTPS / JWT\&quot;)\n  Rel(spa, api, \&quot;Calls REST API with Bearer JWT\&quot;, \&quot;HTTPS / JSON\&quot;)\n  Rel(api, firebase, \&quot;Verify ID tokens (JWKS)\&quot;, \&quot;HTTPS\&quot;)\n  Rel(api, db, \&quot;Executes ACID transactions and row locks\&quot;, \&quot;TLS / TCP 5432\&quot;)\n\n  UpdateElementStyle(visitor, $bgColor=\&quot;#08427B\&quot;, $fontColor=\&quot;#FFFFFF\&quot;, $borderColor=\&quot;#052E56\&quot;)\n  UpdateElementStyle(player, $bgColor=\&quot;#0044FF\&quot;, $fontColor=\&quot;#FFFFFF\&quot;, $borderColor=\&quot;#002DB3\&quot;)\n  UpdateElementStyle(owner, $bgColor=\&quot;#0044FF\&quot;, $fontColor=\&quot;#FFFFFF\&quot;, $borderColor=\&quot;#002DB3\&quot;)\n  UpdateElementStyle(spa, $bgColor=\&quot;#1168BD\&quot;, $fontColor=\&quot;#FFFFFF\&quot;, $borderColor=\&quot;#0B4884\&quot;)\n  UpdateElementStyle(api, $bgColor=\&quot;#1168BD\&quot;, $fontColor=\&quot;#FFFFFF\&quot;, $borderColor=\&quot;#0B4884\&quot;)\n  UpdateElementStyle(db, $bgColor=\&quot;#1168BD\&quot;, $fontColor=\&quot;#FFFFFF\&quot;, $borderColor=\&quot;#0B4884\&quot;)\n  UpdateElementStyle(firebase, $bgColor=\&quot;#8C8C8C\&quot;, $fontColor=\&quot;#FFFFFF\&quot;, $borderColor=\&quot;#707070\&quot;)\n\n  UpdateRelStyle(visitor, spa, $textColor=\&quot;#0000FF\&quot;, $lineColor=\&quot;#555555\&quot;)\n  UpdateRelStyle(player, spa, $textColor=\&quot;#0000FF\&quot;, $lineColor=\&quot;#555555\&quot;)\n  UpdateRelStyle(owner, spa, $textColor=\&quot;#0000FF\&quot;, $lineColor=\&quot;#555555\&quot;)\n  UpdateRelStyle(spa, firebase, $textColor=\&quot;#0000FF\&quot;, $lineColor=\&quot;#555555\&quot;)\n  UpdateRelStyle(spa, api, $textColor=\&quot;#0000FF\&quot;, $lineColor=\&quot;#555555\&quot;)\n  UpdateRelStyle(api, firebase, $textColor=\&quot;#0000FF\&quot;, $lineColor=\&quot;#555555\&quot;)\n  UpdateRelStyle(api, db, $textColor=\&quot;#0000FF\&quot;, $lineColor=\&quot;#555555\&quot;)&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="R0q7PPUtHbZDGFMB3n8S-48">
