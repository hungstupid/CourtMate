<mxfile host="app.diagrams.net">
  <diagram name="Page-1" id="u6ardEIzXJVCv3-A8aqL">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;C4Component\n  title Component Diagram for FastAPI Backend (C4 Level 3)\n\n  Container(spa, \&quot;Single-Page Application\&quot;, \&quot;React, TypeScript, Vite\&quot;, \&quot;Responsive Web UI running in browser.\&quot;)\n  System_Ext(firebase, \&quot;Firebase Authentication\&quot;, \&quot;External Service. Provides JWKS to verify ID tokens.\&quot;)\n  ContainerDb(db, \&quot;Relational Database\&quot;, \&quot;PostgreSQL 17 (Neon)\&quot;, \&quot;11 tables: users, courts, operating_hours, slots, maintenance_blocks, bookings, booking_slots, slot_claims, rooms, room_members, slot_offers.\&quot;)\n\n  Container_Boundary(api, \&quot;FastAPI Backend Application\&quot;) {\n    Component(identity, \&quot;IdentityAPI / Auth\&quot;, \&quot;api/identity.py, core/auth.py\&quot;, \&quot;Verifies Firebase JWTs, resolves current_user, enforces role (player | owner), updates basic profile.\&quot;)\n    Component(courts, \&quot;CourtsAPI / Courts\&quot;, \&quot;api/courts.py, services/courts.py\&quot;, \&quot;Manages owned courts, operating hours, batch slot publication, maintenance blocks, search &amp; slot previews.\&quot;)\n    Component(bookings, \&quot;BookingsAPI / Bookings\&quot;, \&quot;api/bookings.py, services/bookings.py\&quot;, \&quot;Reviews &amp; confirms 1-4 consecutive slots atomically, manages snapshots/claims, cancels whole booking (&gt;= 6h).\&quot;)\n    Component(rooms, \&quot;RoomsAPI / Rooms\&quot;, \&quot;api/rooms.py, services/rooms.py\&quot;, \&quot;Creates 1 room per booking, area search, join/leave capacity locks, cost estimate &amp; sticky closure.\&quot;)\n    Component(offers, \&quot;OffersAPI / Offers\&quot;, \&quot;api/offers.py, services/offers.py\&quot;, \&quot;Manages manual/automatic slot offers (0 &lt; h &lt;= 24), evaluates SCHEDULED/ACTIVE state, returns effective quotes.\&quot;)\n    Component(session, \&quot;Session &lt;&lt;SQLAlchemy&gt;&gt;\&quot;, \&quot;db/session.py\&quot;, \&quot;Request-scoped Unit of Work; executes SQL, acquires row locks, commits on success or rolls back on failure.\&quot;)\n  }\n\n  Rel(spa, identity, \&quot;Auth &amp; profile API\&quot;, \&quot;HTTPS / JSON\&quot;)\n  Rel(spa, courts, \&quot;Search, court &amp; schedule API\&quot;, \&quot;HTTPS / JSON\&quot;)\n  Rel(spa, bookings, \&quot;Review, confirm &amp; cancel API\&quot;, \&quot;HTTPS / JSON\&quot;)\n  Rel(spa, rooms, \&quot;Open Play Room API\&quot;, \&quot;HTTPS / JSON\&quot;)\n  Rel(spa, offers, \&quot;Slot offers API\&quot;, \&quot;HTTPS / JSON\&quot;)\n\n  Rel(identity, firebase, \&quot;Verify ID tokens (JWKS)\&quot;, \&quot;HTTPS\&quot;)\n  Rel(courts, identity, \&quot;Check Owner role &amp; ownership\&quot;)\n  Rel(bookings, identity, \&quot;Check Player/Owner role &amp; ownership\&quot;)\n  Rel(rooms, identity, \&quot;Check Player &amp; Organizer ownership\&quot;)\n  Rel(offers, identity, \&quot;Check Owner role &amp; ownership\&quot;)\n\n  Rel(courts, offers, \&quot;Query effective slot quotes\&quot;)\n  Rel(bookings, courts, \&quot;Lock Court/Slot &amp; validate schedule\&quot;)\n  Rel(bookings, offers, \&quot;Call quote(slot, now)\&quot;)\n  Rel(bookings, rooms, \&quot;Close linked Room on cancel\&quot;)\n  Rel(rooms, bookings, \&quot;Lock Court/Booking &amp; inherit total\&quot;)\n  Rel(offers, courts, \&quot;Validate owned eligible Slot\&quot;)\n\n  Rel(identity, session, \&quot;users\&quot;)\n  Rel(courts, session, \&quot;courts, hours, slots, maintenance\&quot;)\n  Rel(bookings, session, \&quot;bookings, booking_slots, slot_claims\&quot;)\n  Rel(rooms, session, \&quot;rooms, room_members\&quot;)\n  Rel(offers, session, \&quot;slot_offers\&quot;)\n  Rel(session, db, \&quot;ACID transactions &amp; SELECT FOR UPDATE\&quot;, \&quot;TLS / TCP 5432\&quot;)\n\n  UpdateElementStyle(spa, $bgColor=\&quot;#0044FF\&quot;, $fontColor=\&quot;#FFFFFF\&quot;, $borderColor=\&quot;#002DB3\&quot;)\n  UpdateElementStyle(identity, $bgColor=\&quot;#1168BD\&quot;, $fontColor=\&quot;#FFFFFF\&quot;, $borderColor=\&quot;#0B4884\&quot;)\n  UpdateElementStyle(courts, $bgColor=\&quot;#1168BD\&quot;, $fontColor=\&quot;#FFFFFF\&quot;, $borderColor=\&quot;#0B4884\&quot;)\n  UpdateElementStyle(bookings, $bgColor=\&quot;#1168BD\&quot;, $fontColor=\&quot;#FFFFFF\&quot;, $borderColor=\&quot;#0B4884\&quot;)\n  UpdateElementStyle(rooms, $bgColor=\&quot;#1168BD\&quot;, $fontColor=\&quot;#FFFFFF\&quot;, $borderColor=\&quot;#0B4884\&quot;)\n  UpdateElementStyle(offers, $bgColor=\&quot;#1168BD\&quot;, $fontColor=\&quot;#FFFFFF\&quot;, $borderColor=\&quot;#0B4884\&quot;)\n  UpdateElementStyle(session, $bgColor=\&quot;#08427B\&quot;, $fontColor=\&quot;#FFFFFF\&quot;, $borderColor=\&quot;#052E56\&quot;)\n  UpdateElementStyle(db, $bgColor=\&quot;#1168BD\&quot;, $fontColor=\&quot;#FFFFFF\&quot;, $borderColor=\&quot;#0B4884\&quot;)\n  UpdateElementStyle(firebase, $bgColor=\&quot;#8C8C8C\&quot;, $fontColor=\&quot;#FFFFFF\&quot;, $borderColor=\&quot;#707070\&quot;)\n\n  UpdateRelStyle(spa, identity, $textColor=\&quot;#0000FF\&quot;, $lineColor=\&quot;#555555\&quot;)\n  UpdateRelStyle(spa, courts, $textColor=\&quot;#0000FF\&quot;, $lineColor=\&quot;#555555\&quot;)\n  UpdateRelStyle(spa, bookings, $textColor=\&quot;#0000FF\&quot;, $lineColor=\&quot;#555555\&quot;)\n  UpdateRelStyle(spa, rooms, $textColor=\&quot;#0000FF\&quot;, $lineColor=\&quot;#555555\&quot;)\n  UpdateRelStyle(spa, offers, $textColor=\&quot;#0000FF\&quot;, $lineColor=\&quot;#555555\&quot;)\n  UpdateRelStyle(identity, firebase, $textColor=\&quot;#0000FF\&quot;, $lineColor=\&quot;#555555\&quot;)\n  UpdateRelStyle(session, db, $textColor=\&quot;#0000FF\&quot;, $lineColor=\&quot;#555555\&quot;)&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="uRD0e9JiVf4VH4UNZ9kx-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;fontSize=13;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
