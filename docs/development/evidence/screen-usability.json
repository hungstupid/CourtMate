  "defects": [
    {
      "id": "UX-01",
      "priority": "P1",
      "issue": "Fields editable after request snapshot; later success marks unsent values clean or leaves the page.",
      "fix": "Freeze editable inputs during writes in Auth/Profile/Court/Hours/Slot/room-capacity forms; aria-busy and visual feedback. Profile reproducer confirmed actual UI/committed-data mismatch before correction."
    },
    {
      "id": "UX-02",
      "priority": "P2",
      "issue": "Saved-profile message remains after another unsaved edit.",
      "fix": "Clear success feedback on the next field change; retain draft guard."
    },
    {
      "id": "UX-03",
      "priority": "P2",
      "issue": "Create-room failure/readback remount resets capacity 12 to default 4.",
      "fix": "Keep capacity in page state; retry preserves it and real room persists capacity 12 after reload."
    },
    {
      "id": "UX-04",
      "priority": "P1",
      "issue": "Network response lost after room commit still offers another create attempt.",
      "fix": "Authoritative booking readback with room_id shows a link to the existing room; no fake success and no duplicate submission. Test forwards the real POST, then drops only the browser response; exactly one room is read back."
    },
    {
      "id": "UX-05",
      "priority": "P2",
      "issue": "Clicks inside the native dialog padding dismiss it as though they hit the backdrop.",
      "fix": "Dismiss only coordinates outside dialog bounds. Inside padding, actual outside click, Escape and focus return are tested."
    },
    {
      "id": "UX-06",
      "priority": "P2",
      "issue": "23:00–00:00 looks reversed; multi-day maintenance omits its end date.",
      "fix": "Show 24:00 for the exact end of the same playing day; show explicit end date for longer ranges. Actual calendar/availability/review/accepted booking and maintenance preview/save/reload tested."
    }
  ],
  "notClaimed": [
    "Human usability study with representative Players/Owners",
    "Human VoiceOver/NVDA tasks",
    "Exhaustive cross-browser/real-device or text-zoom review",
    "Figma prototype playback",
    "Production authenticated write acceptance"
  ],
  "optionalImprovements": [
    "User-test password visibility control before adding UI",
    "User-test progressive disclosure for the long mobile court form; preserve required fields/drafts and PA2 behavior"
  ],
  "verificationNotes": [
    "An initial local run used a stale API port and did not establish product failures. The test Vite server was relaunched with explicit demo emulator/local API configuration.",
    "Two harness issues were corrected: await completed sign-out/session restoration, and read saved slots through the existing collection endpoint. Court search matrix uses the existing q query parameter. These are not counted as product defects."
  ]
