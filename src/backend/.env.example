# Comma-separated origins; include the full scheme, host and port.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_ENV=local
# make setup generates matching random local credentials; never copy cloud secrets here.
DATABASE_URL=postgresql+psycopg://courtmate:replace-with-local-password@127.0.0.1:5433/courtmate
MIGRATION_DATABASE_URL=postgresql+psycopg://courtmate:replace-with-local-password@127.0.0.1:5433/courtmate
TEST_DATABASE_URL=postgresql+psycopg://courtmate:replace-with-local-password@127.0.0.1:5433/courtmate_test
FIREBASE_PROJECT_ID=demo-courtmate
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
